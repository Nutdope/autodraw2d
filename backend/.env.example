# Copy to backend/.env (never commit the real file)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CORS_ORIGINS=http://localhost:5173
AI_RATE_LIMIT=5/hour
# Total live AI calls per day across all visitors (protects your Gemini quota)
AI_DAILY_LIMIT=50/day
# Tried in order on 503 / 404 / 429 (free-tier quotas are per model)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
